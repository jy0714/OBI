; OBI 로컬 설정 견본 — 이 파일을 obi.ini 로 복사해서 쓰세요. (obi.ini 는 커밋되지 않습니다)
; 다른 위치의 파일을 쓰려면 환경변수 OBI_CONFIG_PATH 에 경로를 지정합니다.

[auth]
; 첫 화면 접속 비밀번호 — 반드시 4자리 숫자. 비어 있으면 앱이 열리지 않습니다.
password =

[ollama]
; 로컬 Ollama 서버 주소
base_url = http://localhost:11434
; 화면에서 고를 수 있는 모델 (쉼표로 구분). 이 중 `ollama list` 에 있는 모델만 표시됩니다.
; 비워 두면 `ollama list` 의 모든 모델을 표시합니다.
models = gemma4:31b, qwen3.8:27b

[openai]
; OpenAI 형식(/chat/completions) 외부 API
base_url = https://api.openai.com/v1
model = gpt-4o-mini
; API 키는 이 파일에만 둡니다. 화면에서 입력하면 그 세션에서만 이 값을 대신합니다.
api_key =
